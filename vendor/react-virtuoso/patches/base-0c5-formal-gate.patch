+;(globalThis as any).IS_REACT_ACT_ENVIRONMENT = true
+
+function resizeObserverStub(callbacks: ResizeObserverCallback[]) {
+  return class {
+    constructor(callback: ResizeObserverCallback) {
+      callbacks.push(callback)
+    }
+    disconnect() {}
+    observe() {}
+    unobserve() {}
+  } as unknown as typeof ResizeObserver
+}
+
+it('uses same-paint delivery only when the observation predicate owns the resize', async () => {
+  const callbacks: ResizeObserverCallback[] = []
+  const frames: FrameRequestCallback[] = []
+  const NativeResizeObserver = globalThis.ResizeObserver
+  const raf = vi.spyOn(globalThis, 'requestAnimationFrame').mockImplementation((callback) => {
+    frames.push(callback)
+    return frames.length
+  })
+  globalThis.ResizeObserver = resizeObserverStub(callbacks)
+  const callback = vi.fn()
+  const samePaint = vi.fn(() => false)
+  const container = document.createElement('div')
+  document.body.append(container)
+  const root = ReactDOM.createRoot(container)
+
+  function Subject() {
+    const { callbackRef } = useSizeWithElRef(callback, true, false, samePaint)
+    return <div ref={callbackRef} />
+  }
+
+  try {
+    act(() => root.render(<Subject />))
+    const element = container.firstElementChild as HTMLElement
+    Object.defineProperty(element, 'offsetParent', { configurable: true, value: container })
+    const entry = { target: element } as unknown as ResizeObserverEntry
+
+    act(() => callbacks[0]!([entry], {} as ResizeObserver))
+    expect(callback).not.toHaveBeenCalled()
+    expect(frames).toHaveLength(1)
+    act(() => frames.shift()!(0))
+    expect(callback).toHaveBeenCalledTimes(1)
+
+    samePaint.mockReturnValue(true)
+    await act(async () => {
+      callbacks[0]!([entry], {} as ResizeObserver)
+      await Promise.resolve()
+    })
+    expect(callback).toHaveBeenCalledTimes(2)
+    expect(frames).toHaveLength(0)
+  } finally {
+    act(() => root.unmount())
+    container.remove()
+    globalThis.ResizeObserver = NativeResizeObserver
+    raf.mockRestore()
+  }
+})
