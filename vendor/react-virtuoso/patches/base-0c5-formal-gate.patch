+it('uses same-paint list delivery only for changed active child geometry', async () => {
+  const callbacks: ResizeObserverCallback[] = []
+  const frames: FrameRequestCallback[] = []
+  const NativeResizeObserver = globalThis.ResizeObserver
+  const raf = vi.spyOn(globalThis, 'requestAnimationFrame').mockImplementation((callback) => {
+    frames.push(callback)
+    return frames.length
+  })
+  globalThis.ResizeObserver = resizeObserverStub(callbacks)
+  const changed = vi.fn()
+  const container = document.createElement('div')
+  document.body.append(container)
+  const root = ReactDOM.createRoot(container)
+  let actualSize = 100
+
+  function Subject() {
+    const { callbackRef } = useChangedListContentsSizes(
+      changed,
+      () => actualSize,
+      true,
+      vi.fn(),
+      vi.fn(),
+      undefined,
+      undefined,
+      false,
+      false,
+      undefined,
+      true
+    )
+    return (
+      <div data-virtuoso-scroller>
+        <div ref={callbackRef}>
+          <div data-index="0" data-known-size="100" />
+        </div>
+      </div>
+    )
+  }
+
+  try {
+    act(() => root.render(<Subject />))
+    const host = container.querySelector<HTMLElement>('[data-virtuoso-scroller] > div')!
+    const child = host.firstElementChild as HTMLElement
+    Object.defineProperty(host, 'offsetParent', { configurable: true, value: container })
+    const entry = { target: host } as unknown as ResizeObserverEntry
+
+    act(() => callbacks[0]!([entry], {} as ResizeObserver))
+    expect(changed).not.toHaveBeenCalled()
+    expect(frames).toHaveLength(1)
+    act(() => frames.shift()!(0))
+    expect(changed).toHaveBeenLastCalledWith(expect.objectContaining({ ranges: [] }))
+
+    changed.mockClear()
+    actualSize = 120
+    await act(async () => {
+      callbacks[0]!([entry], {} as ResizeObserver)
+      await Promise.resolve()
+    })
+    expect(changed).toHaveBeenCalledWith(expect.objectContaining({ ranges: [{ endIndex: 0, size: 120, startIndex: 0 }] }))
+    expect(frames).toHaveLength(0)
+
+    for (const excludedAttribute of ['formalPreparing', 'historyPreparing', 'historyRetained'] as const) {
+      changed.mockClear()
+      child.dataset[excludedAttribute] = '1'
+      actualSize += 20
+      act(() => callbacks[0]!([entry], {} as ResizeObserver))
+      expect(changed).not.toHaveBeenCalled()
+      expect(frames).toHaveLength(1)
+      act(() => frames.shift()!(0))
+      expect(changed).toHaveBeenLastCalledWith(expect.objectContaining({ ranges: [] }))
+      delete child.dataset[excludedAttribute]
+    }
+  } finally {
+    act(() => root.unmount())
+    container.remove()
+    globalThis.ResizeObserver = NativeResizeObserver
+    raf.mockRestore()
+  }
+})
