+import { describe, expect, it, vi } from 'vitest'
+
+import { measuredHistoryAdmission } from '../src/measuredHistoryAdmission'
+import { getValue } from '../src/urx'
+
+function fixture() {
+  const admit = vi.fn()
+  const fail = vi.fn()
+  const gate = measuredHistoryAdmission({ admit, fail, key: (_index, data) => data })
+  gate.request(['a', 'b'], 100)
+  admit.mockClear()
+  return { ...gate, admit, fail }
+}
+
+describe('real DOM history admission', () => {
+  it('keeps a transient zero-height resource retryable and admits its later real size', () => {
+    const gate = fixture()
+    gate.request(['x', 'a', 'b'], 99)
+    const token = getValue(gate.preparation)!
+    gate.observe(token, 800, [0])
+    expect(getValue(gate.preparation)).toBe(token)
+    expect(gate.admit).not.toHaveBeenCalled()
+    gate.observe(token, 800, [127])
+    expect(gate.admit).toHaveBeenCalledWith(['x', 'a', 'b'], 99, 3, [127])
+  })
+  it('does not admit prefix indexes or heights before exact DOM observation', () => {
+    const gate = fixture()
+    gate.request(['x', 'y', 'a', 'b'], 98)
+    expect(gate.admit).not.toHaveBeenCalled()
+    const token = getValue(gate.preparation)!
+    gate.observe(token, 800, [117, 309])
+    expect(gate.admit).toHaveBeenLastCalledWith(['x', 'y', 'a', 'b'], 98, 4, [117, 309])
+    expect(getValue(gate.preparation)).toBeNull()
+  })
+
+  it('prepares bounded live batches and atomically admits the exact full prefix', () => {
+    const gate = fixture()
+    const prefix = Array.from({ length: 35 }, (_, index) => `p${index}`)
+    gate.request([...prefix, 'a', 'b'], 65)
+    const first = getValue(gate.preparation)!
+    expect(first.start).toBe(3)
+    gate.observe(
+      first,
+      800,
+      Array.from({ length: 32 }, () => 100)
+    )
+    const second = getValue(gate.preparation)!
+    expect(second.start).toBe(0)
+    expect(second.end).toBe(3)
+    expect(gate.admit).not.toHaveBeenCalled()
+    gate.observe(
+      first,
+      800,
+      Array.from({ length: 32 }, () => 1)
+    )
+    expect(getValue(gate.preparation)).toBe(second)
+    gate.observe(second, 700, [90, 90, 90])
+    expect(getValue(gate.preparation)).toBeNull()
+    expect(gate.admit).toHaveBeenLastCalledWith([...prefix, 'a', 'b'], 65, 37, [
+      ...Array.from({ length: 3 }, () => 90),
+      ...Array.from({ length: 32 }, () => 100),
+    ])
+  })
+
+  it('does not freeze a non-prefix replacement in the history gate', () => {
+    const gate = fixture()
+    gate.request(['x', 'b', 'a'], 99)
+    expect(gate.fail).not.toHaveBeenCalled()
+    expect(gate.admit).toHaveBeenCalledWith(['x', 'b', 'a'], 99, 3)
+  })
+
+  it('prepares a data-less totalCount prepend in the same accepted source transaction', () => {
+    const admit = vi.fn()
+    const gate = measuredHistoryAdmission({ admit, fail: vi.fn(), key: (index) => index })
+    gate.request(undefined, 100, 2)
+    admit.mockClear()
+    gate.request(undefined, 98, 4)
+    const token = getValue(gate.preparation)!
+    expect(token).toMatchObject({ firstItemIndex: 98, start: 0, end: 2, totalCount: 4 })
+    expect(admit).not.toHaveBeenCalled()
+    gate.observe(token, 800, [81, 93])
+    expect(admit).toHaveBeenCalledWith(undefined, 98, 4, [81, 93])
+  })
+})
