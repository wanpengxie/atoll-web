+import * as u from './urx'
+
+import type { Data } from './sizeSystem'
+
+export interface HistoryPreparation {
+  data: readonly unknown[] | undefined
+  firstItemIndex: number
+  generation: number
+  prefixCount: number
+  start: number
+  end: number
+  totalCount: number
+}
+
+/** Private admission gate: requested history is not list geometry until measured. */
+export function measuredHistoryAdmission(options: {
+  admit: (data: Data, firstItemIndex: number, totalCount: number, prefixSizes?: readonly number[]) => void
+  key: (index: number, data: unknown) => unknown
+  fail: (reason: string) => void
+  enabled?: () => boolean
+}) {
+  const preparation = u.statefulStream<HistoryPreparation | null>(null)
+  let acceptedData: Data
+  let acceptedFirst = 0
+  let acceptedTotalCount = 0
+  let generation = 0
+  let pendingPrefixSizes: number[] | null = null
+
+  function request(data: Data, firstItemIndex: number, totalCount = data?.length ?? 0) {
+    const active = u.getValue(preparation)
+    if (active && active.data === data && active.firstItemIndex === firstItemIndex && active.totalCount === totalCount) {
+      return
+    }
+    if (acceptedData === data && acceptedFirst === firstItemIndex && acceptedTotalCount === totalCount && active === null) {
+      return
+    }
+    generation++
+    const prefixCount = acceptedFirst - firstItemIndex
+    if (options.enabled?.() !== false && acceptedTotalCount > 0 && prefixCount > 0) {
+      const suffixMatches =
+        acceptedData !== undefined && data !== undefined
+          ? data.length >= acceptedData.length + prefixCount &&
+            acceptedData.every(
+              (item, index) => options.key(acceptedFirst + index, item) === options.key(acceptedFirst + index, data[prefixCount + index])
+            )
+          : acceptedData === undefined && data === undefined && totalCount === acceptedTotalCount + prefixCount
+      if (!suffixMatches) {
+        u.publish(preparation, null)
+        pendingPrefixSizes = null
+        acceptedData = data
+        acceptedFirst = firstItemIndex
+        acceptedTotalCount = totalCount
+        // A replacement/rebase is not a history-prefix insertion. Preserve its
+        // existing public behavior rather than freezing the requested data.
+        options.admit(data, firstItemIndex, totalCount)
+        return
+      }
+      pendingPrefixSizes = Array.from({ length: prefixCount }, () => 0)
+      u.publish(preparation, {
+        data,
+        firstItemIndex,
+        generation,
+        prefixCount,
+        start: Math.max(0, prefixCount - 32),
+        end: prefixCount,
+        totalCount,
+      })
+      return
+    }
+    u.publish(preparation, null)
+    pendingPrefixSizes = null
+    acceptedData = data
+    acceptedFirst = firstItemIndex
+    acceptedTotalCount = totalCount
+    options.admit(data, firstItemIndex, totalCount)
+  }
+
+  function observe(token: HistoryPreparation, inlineSize: number, heights: readonly number[]) {
+    if (u.getValue(preparation) !== token) {
+      return
+    }
+    if (!(inlineSize > 0) || heights.some((size) => size === 0)) {
+      // No invented placeholder size: keep the request and let its live row
+      // ResizeObservers retry when a zero-sized resource obtains dimensions.
+      return
+    }
+    if (heights.length !== token.end - token.start || heights.some((size) => !Number.isFinite(size) || size < 0)) {
+      options.fail('Measured history received invalid live DOM dimensions')
+      return
+    }
+    if (pendingPrefixSizes === null || pendingPrefixSizes.length !== token.prefixCount) {
+      options.fail('Measured history lost its preparation generation')
+      return
+    }
+    heights.forEach((height, index) => {
+      pendingPrefixSizes![token.start + index] = height
+    })
+    if (token.start > 0) {
+      u.publish(preparation, {
+        ...token,
+        generation: ++generation,
+        start: Math.max(0, token.start - 32),
+        end: token.start,
+      })
+      return
+    }
+    const prefixSizes = pendingPrefixSizes
+    pendingPrefixSizes = null
+    acceptedData = token.data
+    acceptedFirst = token.firstItemIndex
+    acceptedTotalCount = token.totalCount
+    options.admit(acceptedData, acceptedFirst, acceptedTotalCount, prefixSizes)
+    u.publish(preparation, null)
+  }
+
+  return { observe, preparation, request }
+}
