+    const states: { blocking: boolean; generation: number; phase: string; reason?: string }[] = []
+    let renders = 0
+    const Fixture = () => {
+      renders++
+      const previous = React.useRef<(typeof states)[number] | null>(null)
+      const [, setRevision] = React.useState(0)
+      const data = React.useMemo(() => Array.from({ length: 20 }, (_, index) => `row-${index}`), [])
+      const measurementKey = React.useCallback((_index: number, row: string) => row, [])
+      const itemSize = React.useCallback(() => 40, [])
+      const onFormalState = React.useCallback((state: (typeof states)[number]) => {
+        states.push(state)
+        if (
+          previous.current?.generation === state.generation &&
+          previous.current.phase === state.phase &&
+          previous.current.reason === state.reason &&
+          previous.current.blocking === state.blocking
+        ) {
+          return
+        }
+        previous.current = state
+        setRevision((value) => value + 1)
+      }, [])
+      return (
+        <Virtuoso
+          data={data}
+          computeItemMeasurementKey={measurementKey}
+          defaultItemHeight={40}
+          formalRangeStateChange={onFormalState}
+          initialTopMostItemIndex={{ align: 'end', index: 'LAST' }}
+          itemSize={itemSize}
+        />
+      )
+    }
