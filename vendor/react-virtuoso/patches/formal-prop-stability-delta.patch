+      const viewport = scroller.firstElementChild as any
+      const list = container.querySelector<HTMLElement>('[data-testid="virtuoso-item-list"]')!
+      Object.defineProperty(list, 'clientWidth', { configurable: true, value: 800 })
+      act(() => {
+        scroller.triggerScroll({ scrollHeight: 800, scrollTop: 380, viewportHeight: 420 })
+        viewport.triggerResize({ getBoundingClientRect: () => ({ height: 420 }) })
+        for (let count = 0; count < 10; count++) {
+          ;(list as any).triggerChangedChildSizes([])
+          for (const callback of resizeCallbacks.splice(0)) {
+            callback()
+          }
+          while (frames.length) {
+            frames.shift()!(0)
+          }
+        }
+      })
+      const ready = states.findLast((state) => state.phase === 'ready')
+      expect(ready).toBeDefined()
+      expect(states.some((state) => state.generation > ready!.generation)).toBe(false)
+      expect(renders).toBeLessThan(10)
+    } finally {
+      act(() => root.unmount())
+      globalThis.ResizeObserver = NativeResizeObserver
+      raf.mockRestore()
+    }
+  })
