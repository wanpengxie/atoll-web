{
  "name": "atoll-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:ci": "playwright test tests/browser/f7-request-turn-progress.spec.js tests/browser/f7-terminal.spec.js tests/browser/f8-terminal-session.spec.js tests/browser/phase-b.spec.js --grep '^(F7|F8|B-BR-02a)'",
    "test:ci": "npm test && npm run test:browser:ci && npm run build",
    "test:all": "npm test && npm run test:browser && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "jsdom": "^27.0.1",
    "vite": "^8.0.13",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-mention": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/suggestion": "^3.30.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  }
}
